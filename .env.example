# MiniMax API Key
# Get your API key from https://platform.minimaxi.com/
MINIMAX_API_KEY=your_api_key_here

# Optional: path to the SQLite knowledge base (default: ./kb.db)
# YTSCRAPER_DB_PATH=/opt/ytscraper/kb.db

# Optional: Hugging Face cache for sentence-transformers model
# Set to a persistent path on the VM so the model isn't re-downloaded
# HF_HOME=/opt/ytscraper/.cache/huggingface
# SENTENCE_TRANSFORMERS_HOME=/opt/ytscraper/.cache/sentence-transformers