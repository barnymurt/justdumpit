# MiniMax API Key
# Get your API key from https://platform.minimaxi.com/
MINIMAX_API_KEY=your_api_key_here

# Optional: path to the SQLite knowledge base (default: ./kb.db)
# YTSCRAPER_DB_PATH=/opt/ytscraper/kb.db

# Optional: Hugging Face cache for sentence-transformers model
# Set to a persistent path on the VM so the model isn't re-downloaded
# HF_HOME=/opt/ytscraper/.cache/huggingface
# SENTENCE_TRANSFORMERS_HOME=/opt/ytscraper/.cache/sentence-transformers

# ---------------------------------------------------------------------------
# YouTube Watch Later pipeline
# ---------------------------------------------------------------------------
# YouTube Data API v3 OAuth2 client (https://console.cloud.google.com/apis/credentials)
# Application type: Desktop app
# Scope: https://www.googleapis.com/auth/youtube.readonly
# Token is auto-saved at /data/youtube_token.json (Fly) or ./data/youtube_token.json (local)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Gmail API OAuth2 client (same Google Cloud project, separate credential)
# Application type: Desktop app
# Scope: https://www.googleapis.com/auth/gmail.send
# Token is auto-saved at /data/gmail_token.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Gmail sender address (must match the OAuth-authorized account)
GMAIL_ADDRESS=

# Watch Later background loop
WATCH_LATER_ENABLED=true
WATCH_LATER_POLL_INTERVAL=3600        # seconds; 3600 = 1 hour

# Optional override: comma-separated recipient list (defaults to GMAIL_ADDRESS)
# WATCH_LATER_RECIPIENTS=you@gmail.com,agent@gmail.com